{
  "servers": {
    "graphify": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv-graphify\\Scripts\\python.exe",
      "args": [
        "-m",
        "graphify.serve",
        "--graph",
        "${workspaceFolder}\\graphify-out\\graph.json",
        "--transport",
        "stdio"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
